.godot/

# Raw Codex images behind the terrain art (~100 MB, regenerable with tools/art/terrain_gen.py). The built assets in assets/ are committed.
art_source/terrain/

# Raw Codex image behind the opening's backdrop (regenerable with tools/art/opening_gen.py). The built assets/opening/backdrop.png is committed.
art_source/opening/

# Raw provider output behind the music and ambience beds (regenerable with tools/audio/gen_bed.py). The built assets in assets/audio are committed.
art_source/audio/raw/

# Python bytecode from the tools
__pycache__/

# The raw Codex frames behind the new forms' art (about 160 MB; the built sheets in assets/sheets are committed). Regenerate with
# tools/art/generate_frames.py from the specs in tools/art/forms_*_frames.json, or keep them on disk to re-assemble the sheets.
art_source/frames/forms_*/

# Codex run scratch beside generated frames
art_source/frames/**/.last.txt

# Godot writes .import files next to any PNG it scans, including the review page's sprite copies
docs/**/*.import

# Frames that tools/art/handdraw.py import replaced, kept so a hand-drawn frame can be undone
art_source/.replaced/

# the animated goblin forms are rendered by tools/art/blender (export_forms.py writes them), like forms_*
art_source/frames/anim_*/
