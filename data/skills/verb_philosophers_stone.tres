[resource]
script = ExtResource("1_rpc81")
id = "verb_philosophers_stone"
display_name = "Transmute"
description = "Transmute: convert held essence of the element you hold most into the one you aim at (right water, then round: earth, air, light, dark, fire, mind, blood), three for two. With no aim it makes the one held least. You digest parts faster."
announce = "New verb. Acquired [Transmute]."
source = "form_verb"
