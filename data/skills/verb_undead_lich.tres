script = ExtResource("1_rpc81")
id = "verb_undead_lich"
display_name = "Bone beams"
description = "Bone beams that bounce between enemies, and a blink back from what is in front. A phylactery shard in your remains keeps them from wearing away."
announce = "New verb. Acquired [Bone beams]."
