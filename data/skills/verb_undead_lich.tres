effects = [{"kind": "active", "scene": "res://scenes/abilities/verb.tscn", "values": [8], "spec": {"kind": "chain", "range": 160, "jump": 80, "hops": 3, "damage_type": "dark", "blink": {"distance": 70, "away": true}, "cooldown": 6.0}}]
