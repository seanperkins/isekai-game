extends GutTest
## The wolf, undead, spider and goblin forms of the design doc as game data (generated by tools/build_species_forms.py).

var forms := {}

func before_all() -> void:
	forms = FormLoader.load_all()

func _skill_ids() -> Array:
	var out: Array = []
	for d in DefLoader.load_dir("res://data/skills"):
		if d.source != "enemy_only":
			out.append(d.id)
	return out

func _others() -> Array:
	return forms.values().filter(func(f: FormDef) -> bool: return f.species != "slime")

func test_the_species_have_their_forms() -> void:
	for pair in [["slime", 42], ["wolf", 21], ["undead", 29], ["spider", 21], ["goblin", 28]]:
		assert_eq(FormLoader.of_species(forms, pair[0]).size(), pair[1], pair[0])
	assert_eq(forms.size(), 141)

func test_the_data_passes_the_validator() -> void:
	assert_eq(Array(FormValidator.validate(forms, _skill_ids(), false, TestDefs.real_verb_ids())), [])

func test_every_stage_two_and_three_form_has_at_least_two_children() -> void:
	for f: FormDef in _others():
		var kids := FormLoader.children_of(forms, f.id)
		if f.stage < 4:
			assert_gte(kids.size(), 2, f.id)
		else:
			assert_eq(kids.size(), 0, f.id)

func test_each_species_has_three_or_four_lines() -> void:
	for pair in [["wolf", 3], ["undead", 4], ["spider", 3], ["goblin", 4]]:
		assert_eq(FormLoader.stage2_forms(forms, pair[0]).size(), pair[1], pair[0])

func test_the_hierophant_is_a_third_child_of_the_lich() -> void:
	var ids: Array = FormLoader.children_of(forms, "undead_lich").map(func(f: FormDef) -> String: return f.id)
	assert_eq(ids, ["undead_deathless", "undead_demilich", "undead_hierophant"])

func test_every_new_form_says_what_it_reads_where_it_is_found_and_what_it_does() -> void:
	for f: FormDef in _others():
		assert_false(f.reads.is_empty(), "%s reads nothing" % f.id)
		assert_false(f.host.is_empty(), "%s has no host" % f.id)
		for s in [f.source, f.verb_text, f.gives_up, f.opened_by, f.blurb]:
			assert_ne(s, "", f.id)
		assert_eq(f.grants, ["verb_" + f.id], "%s: its verb and nothing else" % f.id)
		assert_eq(f.traits, [], f.id)

func test_later_elements_are_read_by_twenty_forms_and_never_by_a_stage_two_form() -> void:
	var n := 0
	for f: FormDef in _others():
		var late: Array = f.reads.filter(func(e: String) -> bool: return Essences.LATER.has(e))
		if not late.is_empty():
			n += 1
			assert_gt(f.stage, 2, "%s: a stage-2 form must open from the five elements" % f.id)
	assert_eq(n, 20)

func test_the_four_asks_exist() -> void:
	for id in ["wolf_moonbound", "undead_hierophant", "undead_draugr", "spider_weavermaid"]:
		assert_true(forms.has(id), id)

func test_the_tree_tab_draws_a_new_species_from_its_data() -> void:
	var skills := DefLoader.load_dir("res://data/skills")
	var compendium := CompendiumModel.new(skills, DefLoader.load_dir("res://data/creatures"))
	var r: SkillRulesEngine = autofree(SkillRulesEngine.new())
	r.setup(skills)
	CoreWiring.connect_core(r, compendium, AnnouncerQueue.new())
	r.start_run()
	var model := SkillTreeModel.build(r, compendium, forms, [], "wolf")
	var ids: Array = []
	for id in model["nodes"]:
		if model["nodes"][id]["kind"] == "form":
			ids.append(id)
	assert_eq(ids.size(), 10, "the base, its three lines and their six stage-3 stubs: %s" % str(ids))
	for id in ids:
		assert_true(id == "wolf" or str(id).begins_with("wolf_"), id)
